{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the menu bar panel",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "opener:default",
    "dialog:allow-open",
    "deep-link:default"
  ]
}
